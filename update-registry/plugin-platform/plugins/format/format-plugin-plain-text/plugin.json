{
  "id": "format-plugin-plain-text",
  "plugin_api_version": "1",
  "family": "format",
  "role": "format.subtitle-provider",
  "name": "Plain Text",
  "version": "1.0.0",
  "summary": "Plain text subtitle import and export for quick copy workflows.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["RawFileArtifact", "FormatExportArtifact"],
  "produces": ["FormatImportArtifact", "RawFileArtifact"],
  "permissions": ["filesystem.read"],
  "dependencies": [],
  "capabilities": ["export", "subtitle-format", "plain-text"],
  "format": {
    "id": "plain-text",
    "target": "subtitle",
    "directions": ["export"],
    "extensions": ["txt"],
    "export_order": 20
  },
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64", "macos-x64", "macos-arm64", "linux-x64"]
  }
}
