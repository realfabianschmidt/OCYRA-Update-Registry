{
  "id": "format-plugin-subrip",
  "plugin_api_version": "1",
  "family": "format",
  "role": "format.subtitle-provider",
  "name": "SubRip (SRT)",
  "version": "1.0.0",
  "summary": "SubRip format for YouTube, Vimeo and general subtitle workflows.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["RawFileArtifact", "FormatExportArtifact"],
  "produces": ["FormatImportArtifact", "RawFileArtifact"],
  "permissions": ["filesystem.read"],
  "dependencies": [],
  "capabilities": ["import", "export", "subtitle-format", "timed-subtitle"],
  "format": {
    "id": "subrip",
    "target": "subtitle",
    "directions": ["import", "export"],
    "extensions": ["srt"],
    "export_order": 30,
    "quality_gate": "timed-subtitle"
  },
  "auto_install": true,
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64", "macos-x64", "macos-arm64", "linux-x64"]
  }
}
