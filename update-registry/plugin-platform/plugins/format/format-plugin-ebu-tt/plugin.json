{
  "id": "format-plugin-ebu-tt",
  "plugin_api_version": "1",
  "family": "format",
  "role": "format.subtitle-provider",
  "name": "EBU-TT",
  "version": "1.0.0",
  "summary": "EBU-TT subtitle format for broadcast delivery.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["RawFileArtifact", "FormatExportArtifact"],
  "produces": ["FormatImportArtifact", "RawFileArtifact"],
  "permissions": ["filesystem.read"],
  "dependencies": [],
  "capabilities": ["export", "subtitle-format", "broadcast-subtitle"],
  "format": {
    "id": "ebu-tt",
    "target": "subtitle",
    "directions": ["export"],
    "extensions": ["xml", "ebutt"],
    "export_order": 50,
    "quality_gate": "timed-subtitle"
  },
  "auto_install": true,
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64", "macos-x64", "macos-arm64", "linux-x64"]
  }
}
