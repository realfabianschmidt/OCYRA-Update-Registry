{
  "id": "format-plugin-ocyra-project",
  "plugin_api_version": "1",
  "family": "format",
  "role": "format.project-provider",
  "name": "OCYRA Project",
  "version": "1.0.1",
  "summary": "Native OCYRA project file.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["RawFileArtifact", "FormatExportArtifact"],
  "produces": ["FormatImportArtifact", "RawFileArtifact"],
  "permissions": ["filesystem.read"],
  "dependencies": [],
  "capabilities": ["import", "export", "project-format", "ocyra-native"],
  "format": {
    "id": "ocyra-project",
    "target": "project",
    "directions": ["import", "export"],
    "extensions": ["ocyra", "json"]
  },
  "auto_install": true,
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64", "macos-x64", "macos-arm64", "linux-x64"]
  }
}

