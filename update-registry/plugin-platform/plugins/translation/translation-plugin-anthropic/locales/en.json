{
  "name": "Anthropic Translation",
  "summary": "Cloud subtitle translation through the Anthropic translation backend.",
  "presets": [
    {
      "id": "cloud-anthropic",
      "name": "Cloud Anthropic"
    }
  ],
  "credential_schema": {
    "apiKeyPlaceholder": "sk-ant-...",
    "fields": [
      {
        "key": "anthropic_endpoint",
        "label": "ENDPOINT",
        "placeholder": "https://api.anthropic.com/v1/messages"
      },
      {
        "key": "anthropic_model",
        "label": "MODEL",
        "placeholder": "claude-3-5-sonnet-latest"
      },
      {
        "key": "translation_prompt_pack",
        "label": "PROMPT PACK"
      },
      {
        "key": "translation_prompt_template",
        "label": "CUSTOM PROMPT",
        "placeholder": "Translate subtitle text from {from_lang} to {to_lang}..."
      }
    ]
  }
}
