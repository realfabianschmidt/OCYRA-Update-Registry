{
  "name": "Anthropic Uebersetzung",
  "summary": "Cloud-Untertiteluebersetzung ueber das Anthropic-Uebersetzungs-Backend.",
  "presets": [
    {
      "id": "cloud-anthropic",
      "name": "Anthropic Cloud"
    }
  ],
  "credential_schema": {
    "apiKeyPlaceholder": "sk-ant-...",
    "fields": [
      {
        "key": "anthropic_endpoint",
        "label": "ENDPUNKT",
        "placeholder": "https://api.anthropic.com/v1/messages"
      },
      {
        "key": "anthropic_model",
        "label": "MODELL",
        "placeholder": "claude-3-5-sonnet-latest"
      },
      {
        "key": "translation_prompt_pack",
        "label": "PROMPT-PAKET"
      },
      {
        "key": "translation_prompt_template",
        "label": "BENUTZERDEFINIERTER PROMPT",
        "placeholder": "Untertiteltext von {from_lang} nach {to_lang} uebersetzen..."
      }
    ]
  }
}
