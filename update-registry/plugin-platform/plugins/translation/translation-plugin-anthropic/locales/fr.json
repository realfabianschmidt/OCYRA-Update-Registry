{
  "name": "Traduction Anthropic",
  "summary": "Traduction cloud de sous-titres via le backend de traduction Anthropic.",
  "presets": [
    {
      "id": "cloud-anthropic",
      "name": "Cloud Anthropic"
    }
  ],
  "credential_schema": {
    "apiKeyPlaceholder": "sk-ant-...",
    "fields": [
      {
        "key": "anthropic_endpoint",
        "label": "ENDPOINT",
        "placeholder": "https://api.anthropic.com/v1/messages"
      },
      {
        "key": "anthropic_model",
        "label": "MODELE",
        "placeholder": "claude-3-5-sonnet-latest"
      },
      {
        "key": "translation_prompt_pack",
        "label": "PACK DE PROMPTS"
      },
      {
        "key": "translation_prompt_template",
        "label": "PROMPT PERSONNALISE",
        "placeholder": "Traduire le texte du sous-titre de {from_lang} vers {to_lang}..."
      }
    ]
  }
}
