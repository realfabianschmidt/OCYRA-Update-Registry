{
  "id": "translation-plugin-anthropic",
  "plugin_api_version": "1",
  "family": "translation",
  "role": "translation.subtitle-provider",
  "name": "Anthropic Translation",
  "version": "1.0.1",
  "summary": "Cloud subtitle translation through the Anthropic translation backend.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["TranslationRequestArtifact"],
  "produces": ["TranslationResultArtifact"],
  "permissions": ["network.outbound", "translation.translate"],
  "dependencies": [],
  "settings_schema": "settings.schema.json",
  "credential_schema": {
    "apiKeyProvider": "anthropic",
    "apiKeyPlaceholder": "sk-ant-…",
    "fields": [
      { "key": "anthropic_endpoint", "label": "ENDPOINT", "type": "url",  "placeholder": "https://api.anthropic.com/v1/messages" },
      { "key": "anthropic_model",    "label": "MODEL",    "type": "text", "placeholder": "claude-3-5-sonnet-latest" },
      { "key": "translation_prompt_pack",     "label": "PROMPT PACK",   "type": "select", "source": "packs" },
      { "key": "translation_prompt_template", "label": "CUSTOM PROMPT", "type": "textarea",
        "placeholder": "Translate subtitle text from {from_lang} to {to_lang}…" }
    ]
  },
  "presets": [
    {
      "id": "cloud-anthropic",
      "name": "Cloud Anthropic",
      "settings": {
        "translation_provider": "anthropic"
      }
    }
  ],
  "capabilities": ["cloud", "subtitle-translation"],
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64"]
  }
}
