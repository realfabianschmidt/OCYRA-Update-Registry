{
  "id": "translation-plugin-azure",
  "plugin_api_version": "1",
  "family": "translation",
  "role": "translation.subtitle-provider",
  "name": "Azure OpenAI Translation",
  "version": "1.0.1",
  "summary": "Cloud subtitle translation through the Azure OpenAI translation backend.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["TranslationRequestArtifact"],
  "produces": ["TranslationResultArtifact"],
  "permissions": ["network.outbound", "translation.translate"],
  "dependencies": [],
  "settings_schema": "settings.schema.json",
  "credential_schema": {
    "apiKeyProvider": "azure",
    "apiKeyPlaceholder": "Azure key…",
    "fields": [
      { "key": "ai_endpoint",              "label": "AZURE BASE URL",  "type": "url",  "placeholder": "https://<resource>.openai.azure.com" },
      { "key": "azure_api_version",        "label": "API VERSION",     "type": "text", "placeholder": "2024-06-01" },
      { "key": "azure_chat_deployment",    "label": "CHAT DEPLOYMENT", "type": "text", "placeholder": "gpt-4o-mini" },
      { "key": "translation_prompt_pack",     "label": "PROMPT PACK",   "type": "select", "source": "packs" },
      { "key": "translation_prompt_template", "label": "CUSTOM PROMPT", "type": "textarea",
        "placeholder": "Translate subtitle text from {from_lang} to {to_lang}…" }
    ]
  },
  "presets": [
    {
      "id": "cloud-azure",
      "name": "Cloud Azure",
      "settings": {
        "translation_provider": "azure"
      }
    }
  ],
  "capabilities": ["cloud", "subtitle-translation"],
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64"]
  }
}
