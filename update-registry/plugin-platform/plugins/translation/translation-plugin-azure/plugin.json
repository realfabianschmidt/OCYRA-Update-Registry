{
  "id": "translation-plugin-azure",
  "plugin_api_version": "1",
  "family": "translation",
  "role": "translation.subtitle-provider",
  "name": "Azure OpenAI Translation",
  "version": "1.0.0",
  "summary": "Cloud subtitle translation through the Azure OpenAI translation backend.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["TranslationRequestArtifact"],
  "produces": ["TranslationResultArtifact"],
  "permissions": ["network.outbound"],
  "dependencies": [],
  "settings_schema": "settings.schema.json",
  "presets": [
    {
      "id": "cloud-azure",
      "name": "Cloud Azure",
      "settings": {
        "translation_provider": "azure"
      }
    }
  ],
  "capabilities": ["cloud", "subtitle-translation"],
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64"]
  }
}
