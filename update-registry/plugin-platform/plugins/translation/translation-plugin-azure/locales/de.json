{
  "name": "Azure OpenAI Uebersetzung",
  "summary": "Cloud-Untertiteluebersetzung ueber das Azure-OpenAI-Uebersetzungs-Backend.",
  "presets": [
    {
      "id": "cloud-azure",
      "name": "Azure Cloud"
    }
  ],
  "credential_schema": {
    "apiKeyPlaceholder": "Azure-Key...",
    "fields": [
      {
        "key": "ai_endpoint",
        "label": "AZURE-BASIS-URL",
        "placeholder": "https://<resource>.openai.azure.com"
      },
      {
        "key": "azure_api_version",
        "label": "API-VERSION",
        "placeholder": "2024-06-01"
      },
      {
        "key": "azure_chat_deployment",
        "label": "CHAT-DEPLOYMENT",
        "placeholder": "gpt-4o-mini"
      },
      {
        "key": "translation_prompt_pack",
        "label": "PROMPT-PAKET"
      },
      {
        "key": "translation_prompt_template",
        "label": "BENUTZERDEFINIERTER PROMPT",
        "placeholder": "Untertiteltext von {from_lang} nach {to_lang} uebersetzen..."
      }
    ]
  }
}
