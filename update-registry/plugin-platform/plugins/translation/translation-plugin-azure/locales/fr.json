{
  "name": "Traduction Azure OpenAI",
  "summary": "Traduction cloud de sous-titres via le backend de traduction Azure OpenAI.",
  "presets": [
    {
      "id": "cloud-azure",
      "name": "Cloud Azure"
    }
  ],
  "credential_schema": {
    "apiKeyPlaceholder": "Cle Azure...",
    "fields": [
      {
        "key": "ai_endpoint",
        "label": "URL DE BASE AZURE",
        "placeholder": "https://<resource>.openai.azure.com"
      },
      {
        "key": "azure_api_version",
        "label": "VERSION API",
        "placeholder": "2024-06-01"
      },
      {
        "key": "azure_chat_deployment",
        "label": "DEPLOIEMENT CHAT",
        "placeholder": "gpt-4o-mini"
      },
      {
        "key": "translation_prompt_pack",
        "label": "PACK DE PROMPTS"
      },
      {
        "key": "translation_prompt_template",
        "label": "PROMPT PERSONNALISE",
        "placeholder": "Traduire le texte du sous-titre de {from_lang} vers {to_lang}..."
      }
    ]
  }
}
