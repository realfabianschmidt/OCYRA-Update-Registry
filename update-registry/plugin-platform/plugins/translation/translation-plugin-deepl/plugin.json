{
  "id": "translation-plugin-deepl",
  "plugin_api_version": "1",
  "family": "translation",
  "role": "translation.subtitle-provider",
  "name": "DeepL Translation",
  "version": "1.0.0",
  "summary": "Cloud subtitle translation through the DeepL translation backend.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["TranslationRequestArtifact"],
  "produces": ["TranslationResultArtifact"],
  "permissions": ["network.outbound"],
  "dependencies": [],
  "settings_schema": "settings.schema.json",
  "credential_schema": {
    "apiKeyProvider": "deepl",
    "apiKeyPlaceholder": "DeepL key…",
    "fields": [
      { "key": "deepl_endpoint",  "label": "DEEPL ENDPOINT", "type": "url",
        "placeholder": "https://api-free.deepl.com/v2/translate",
        "help": "Use Pro endpoint if required by your account." },
      { "key": "deepl_formality", "label": "FORMALITY", "type": "select",
        "options": ["default", "more", "less", "prefer_more", "prefer_less"],
        "help": "Only applied for supported target languages." }
    ]
  },
  "presets": [
    {
      "id": "cloud-deepl",
      "name": "Cloud DeepL",
      "settings": {
        "translation_provider": "deepl"
      }
    }
  ],
  "capabilities": ["cloud", "subtitle-translation"],
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64"]
  }
}
