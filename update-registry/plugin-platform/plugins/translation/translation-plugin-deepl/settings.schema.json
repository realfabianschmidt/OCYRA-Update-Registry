{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepL Translation Settings",
  "type": "object",
  "properties": {
    "translation_provider": {
      "type": "string",
      "const": "deepl",
      "default": "deepl"
    },
    "requires_api_key": {
      "type": "boolean",
      "const": true,
      "default": true
    }
  },
  "required": [
    "translation_provider",
    "requires_api_key"
  ],
  "additionalProperties": false
}
