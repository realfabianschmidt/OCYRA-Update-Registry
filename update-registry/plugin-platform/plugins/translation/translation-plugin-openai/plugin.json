{
  "id": "translation-plugin-openai",
  "plugin_api_version": "1",
  "family": "translation",
  "role": "translation.subtitle-provider",
  "name": "OpenAI Translation",
  "version": "1.0.1",
  "summary": "Cloud subtitle translation through the OpenAI translation backend.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["TranslationRequestArtifact"],
  "produces": ["TranslationResultArtifact"],
  "permissions": ["network.outbound", "translation.translate"],
  "dependencies": [],
  "settings_schema": "settings.schema.json",
  "credential_schema": {
    "apiKeyProvider": "openai",
    "apiKeyPlaceholder": "sk-…",
    "fields": [
      { "key": "openai_chat_model",          "label": "CHAT MODEL",    "type": "text", "placeholder": "gpt-4o", "help": "e.g. gpt-4o, gpt-3.5-turbo" },
      { "key": "translation_prompt_pack",     "label": "PROMPT PACK",   "type": "select", "source": "packs" },
      { "key": "translation_prompt_template", "label": "CUSTOM PROMPT", "type": "textarea",
        "placeholder": "Translate subtitle text from {from_lang} to {to_lang}…",
        "help": "Variables: {from_lang}, {to_lang}, {text}. Leave empty for pack default." }
    ]
  },
  "presets": [
    {
      "id": "cloud-openai",
      "name": "Cloud OpenAI",
      "settings": {
        "translation_provider": "openai"
      }
    }
  ],
  "capabilities": ["cloud", "subtitle-translation"],
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64"]
  }
}
