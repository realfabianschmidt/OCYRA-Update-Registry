{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ollama Translation Settings",
  "type": "object",
  "properties": {
    "translation_provider": {
      "type": "string",
      "const": "ollama",
      "default": "ollama"
    },
    "ollama_endpoint": {
      "type": "string",
      "const": "http://127.0.0.1:11435/v1/chat/completions",
      "default": "http://127.0.0.1:11435/v1/chat/completions"
    },
    "ollama_model": {
      "type": "string",
      "const": "qwen2.5:7b",
      "default": "qwen2.5:7b"
    },
    "requires_local_runtime": {
      "type": "boolean",
      "const": true,
      "default": true
    }
  },
  "required": [
    "translation_provider",
    "ollama_endpoint",
    "ollama_model",
    "requires_local_runtime"
  ],
  "additionalProperties": false
}
