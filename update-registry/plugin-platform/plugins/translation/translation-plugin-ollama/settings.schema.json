{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ollama Translation Settings",
  "type": "object",
  "properties": {
    "translation_provider": {
      "type": "string",
      "const": "ollama",
      "default": "ollama"
    },
    "requires_local_runtime": {
      "type": "boolean",
      "const": true,
      "default": true
    }
  },
  "required": [
    "translation_provider",
    "requires_local_runtime"
  ],
  "additionalProperties": false
}
