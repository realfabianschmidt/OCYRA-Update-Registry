{
  "id": "translation-plugin-ollama",
  "plugin_api_version": "1",
  "family": "translation",
  "role": "translation.subtitle-provider",
  "name": "Ollama Translation",
  "version": "1.0.4",
  "summary": "Local subtitle translation through the OCYRA app-bundled Ollama runtime and first-party default model dependency.",
  "runtime": {
    "mode": "js-sandbox",
    "entry": "handler.js"
  },
  "consumes": ["TranslationRequestArtifact"],
  "produces": ["TranslationResultArtifact"],
  "permissions": ["network.outbound", "translation.translate"],
  "dependencies": [
    { "id": "provider-ollama-runtime", "version": "^1.0.0" },
    { "id": "model-ollama-qwen2.5-7b", "version": "^1.0.0" }
  ],
  "settings_schema": "settings.schema.json",
  "credential_schema": {
    "fields": [
      { "key": "ollama_endpoint", "label": "OLLAMA ENDPOINT", "type": "url",  "placeholder": "http://127.0.0.1:11435/v1/chat/completions", "help": "Endpoint is owned by the OCYRA managed Ollama runtime." },
      { "key": "ollama_model",    "label": "MODEL",           "type": "text", "placeholder": "qwen2.5:7b", "help": "Default first-party dependency-managed profile installs qwen2.5:7b. The readiness check requires the exact tag." },
      { "key": "translation_prompt_pack",     "label": "PROMPT PACK",   "type": "select", "source": "packs" },
      { "key": "translation_prompt_template", "label": "CUSTOM PROMPT", "type": "textarea",
        "placeholder": "Translate subtitle text from {from_lang} to {to_lang}…" }
    ]
  },
  "presets": [
    {
      "id": "local-ollama",
      "name": "Local Ollama (Managed Qwen 2.5 7B)",
      "settings": {
        "translation_provider": "ollama",
        "ollama_endpoint": "http://127.0.0.1:11435/v1/chat/completions",
        "ollama_model": "qwen2.5:7b"
      }
    }
  ],
  "capabilities": ["local", "subtitle-translation"],
  "compatibility": {
    "min_app_version": "2.0.0",
    "platforms": ["windows-x64"]
  }
}
