{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "whisper.cpp + Sherpa-ONNX Settings",
  "type": "object",
  "properties": {
    "transcription_provider": {
      "type": "string",
      "const": "whispercpp",
      "default": "whispercpp"
    },
    "diarization_enabled": {
      "type": "boolean",
      "default": true
    },
    "diarization_provider": {
      "type": "string",
      "const": "sherpa-onnx",
      "default": "sherpa-onnx"
    }
  },
  "required": [
    "transcription_provider",
    "diarization_enabled",
    "diarization_provider"
  ],
  "additionalProperties": false
}
