{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAI Whisper Settings",
  "type": "object",
  "properties": {
    "transcription_provider": {
      "type": "string",
      "const": "openai",
      "default": "openai"
    },
    "diarization_enabled": {
      "type": "boolean",
      "default": false
    },
    "requires_api_key": {
      "type": "boolean",
      "const": true,
      "default": true
    }
  },
  "required": [
    "transcription_provider",
    "diarization_enabled",
    "requires_api_key"
  ],
  "additionalProperties": false
}
