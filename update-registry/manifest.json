    { "id": "pyannote", "name": "Pyannote", "kind": "cloud" }
  ],
  "prompt_packs": [
    {
      "id": "default-subtitle-translation",
      "name": "Default Subtitle Translation",
      "template": "Translate subtitle text from {from_lang} to {to_lang}. Preserve line breaks and subtitle structure. Return only translated text."
    },
    {
      "id": "literal-subtitle-translation",
      "name": "Literal Translation",
      "template": "Translate literally from {from_lang} to {to_lang}. Keep punctuation and line breaks. Return only translated subtitle text."
    }
  ],
  "ai_models": [
    {
      "id": "whispercpp-offline-bundle",
      "name": "whisper.cpp Offline Bundle",
      "type": "offline",
      "role": "transcription",
      "provider_id": "whispercpp",
      "size_bytes": 152000000,
      "description": "Local Whisper transcription (model + binary) in a single installation step.",
      "bundle": [
        {
          "url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin",
          "filename": "ggml-base.bin",
          "dest_dir": "models",
          "sha256": "60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe"
        },
        {
          "url": "https://github.com/ggml-org/whisper.cpp/releases/latest/download/whisper-bin-x64.zip",
          "filename": "whisper-x86_64-pc-windows-msvc.exe",
          "dest_dir": "binaries",
          "archive_format": "zip",
          "archive_entry": "whisper-cli.exe",
          "extract_siblings": true,
          "allow_unverified": true
        }
      ],
      "settings_after_install": {
        "transcription_provider": "whispercpp"
      }
    },
    {
      "id": "openai-whisper-api",
      "name": "OpenAI Whisper API",
      "type": "online",
      "role": "transcription",
      "provider_id": "openai",
      "description": "Cloud transcription via OpenAI Whisper.",
      "requires_api_key": true,
      "settings_fields": ["transcription_provider"]
    },
    {
      "id": "azure-speech",
      "name": "Azure Speech",
      "type": "online",
      "role": "transcription",
      "provider_id": "azure",
      "description": "Cloud transcription via Azure Speech.",
      "requires_api_key": true,
      "settings_fields": ["transcription_provider", "ai_endpoint", "azure_whisper_deployment"]
    },
    {
      "id": "sherpa-diarization-bundle",
      "name": "Sherpa-ONNX Speaker Diarization Bundle",
      "type": "offline",
      "role": "diarization",
      "provider_id": "sherpa-onnx",
      "size_bytes": 250000000,
      "description": "Local speaker diarization (binary + segmentation + embedding).",
      "bundle": [
        {
          "url": "https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.12.29/sherpa-onnx-v1.12.29-win-x64-shared-MT-Release.tar.bz2",
          "filename": "sherpa-onnx-offline-speaker-diarization.exe",
          "dest_dir": "binaries",
          "archive_format": "tar.bz2",
          "archive_entry": "sherpa-onnx-v1.12.29-win-x64-shared-MT-Release/bin/sherpa-onnx-offline-speaker-diarization.exe",
          "extract_siblings": true,
          "allow_unverified": true
        },
        {
          "url": "https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-segmentation-models/sherpa-onnx-pyannote-segmentation-3-0.tar.bz2",
          "filename": "sherpa-onnx-pyannote-segmentation.onnx",
          "dest_dir": "models",
          "archive_format": "tar.bz2",
          "archive_entry": "sherpa-onnx-pyannote-segmentation-3-0/model.onnx",
          "allow_unverified": true
        },
        {
          "url": "https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx",
          "filename": "sherpa-onnx-3dspeaker-embedding.onnx",
          "dest_dir": "models",
          "allow_unverified": true
        }
      ],
      "settings_after_install": {
        "diarization_enabled": true,
        "diarization_provider": "sherpa-onnx"
      }
    },
    {
      "id": "pyannote-online",
      "name": "Pyannote API",
      "type": "online",
      "role": "diarization",
      "provider_id": "pyannote",
      "description": "Cloud-Diarization via Pyannote API.",
      "requires_api_key": true,
      "settings_fields": ["diarization_provider", "pyannote_endpoint"]
    },
    {
      "id": "openai-translation",
      "name": "OpenAI Translation",
      "type": "online",
      "role": "translation",
      "provider_id": "openai",
      "description": "Cloud translation via OpenAI.",
      "requires_api_key": true,
      "settings_fields": ["translation_provider"]
    },
    {
      "id": "azure-translation",
      "name": "Azure Translation",
      "type": "online",
      "role": "translation",
