  "update_title": "Update 2026.03.15 available",
  "update_text": "Pipeline packages can now ship strict handler modules that are downloaded, versioned, and activated through the AI package manager.",
  "providers": [
    { "id": "openai", "name": "OpenAI", "kind": "cloud" },
    { "id": "azure", "name": "Azure OpenAI", "kind": "cloud" },
    { "id": "anthropic", "name": "Anthropic", "kind": "cloud" },
    { "id": "deepl", "name": "DeepL", "kind": "cloud" },
    { "id": "ollama", "name": "Ollama", "kind": "local" },
