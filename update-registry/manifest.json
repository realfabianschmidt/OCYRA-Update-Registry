      "description": "Cloud translation with Anthropic Claude.",
      "requires_api_key": true,
      "settings_fields": ["translation_provider", "anthropic_endpoint", "anthropic_model"]
    },
    {
      "id": "deepl-translation",
      "name": "DeepL Translation",
      "type": "online",
      "role": "translation",
      "provider_id": "deepl",
      "description": "Cloud translation via DeepL API.",
      "requires_api_key": true,
      "settings_fields": ["translation_provider", "deepl_endpoint"]
    },
    {
      "id": "ollama-local",
      "name": "Ollama Local Translation",
      "type": "online",
      "role": "translation",
      "provider_id": "ollama",
      "description": "Local translation via Ollama.",
      "requires_api_key": false,
      "settings_fields": ["translation_provider", "ollama_endpoint", "ollama_model"]
    }
