  "accessibility_rules": [
    { "id": "subtitle_duration_min", "label": "Minimum subtitle duration", "value": 1.0, "unit": "seconds" },
    { "id": "subtitle_duration_max", "label": "Maximum subtitle duration", "value": 7.0, "unit": "seconds" },
    { "id": "chars_per_second_max", "label": "Maximum characters per second", "value": 20, "unit": "cps" },
