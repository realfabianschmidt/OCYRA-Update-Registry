        { "id": "sherpa-diarization-bundle", "version": "2026.03.14" }
      ],
      "bundle": [
        {
          "url": "https://raw.githubusercontent.com/realfabianschmidt/XYRA-Captions-Update-Registry/main/update-registry/pipeline-handlers/pipeline-openai-sherpa/handler.js",
          "filename": "handler.js",
          "dest_dir": "pipeline-handlers",
          "sha256": "E06DBE7D7D946A27C52726C71C6616C688E2A95A24D93F4720F8BBF2E80E5DD0"
        }
