      "description": "Cloud translation via Azure OpenAI.",
      "requires_api_key": true,
      "settings_fields": ["translation_provider", "ai_endpoint", "azure_chat_deployment"]
    },
    {
      "id": "anthropic-translation",
      "name": "Anthropic Claude Translation",
      "type": "online",
      "role": "translation",
