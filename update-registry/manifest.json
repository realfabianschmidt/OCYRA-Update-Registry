  "pipeline_packages": [
    {
      "id": "pipeline-whispercpp-sherpa",
      "name": "whisper.cpp + Sherpa-ONNX",
      "type": "pipeline",
      "role": "transcription",
      "stage": "pipeline",
      "provider_id": "whispercpp+sherpa-onnx",
      "version": "1.0.0",
      "manifest_version": "2026.03.15",
      "dependencies": [
        { "id": "whispercpp-offline-bundle", "version": "2026.03.14" },
        { "id": "sherpa-diarization-bundle", "version": "2026.03.14" }
      ],
      "bundle": [
        {
          "url": "https://raw.githubusercontent.com/realfabianschmidt/XYRA-Captions-Update-Registry/main/update-registry/pipeline-handlers/pipeline-whispercpp-sherpa/handler.js",
          "filename": "handler.js",
          "dest_dir": "pipeline-handlers",
          "sha256": "CB7D2A5B2E4953350C66EBD7E6E63CEA141D3320736508BB8A3018747C5DA1E3"
        }
      ],
      "settings_after_install": {
        "transcription_provider": "whispercpp",
        "diarization_enabled": true,
        "diarization_provider": "sherpa-onnx"
      },
      "command": "transcribe_with_diarization",
      "handler_entry": "handler.js",
      "handler_api_version": "1",
      "capabilities": ["offline", "speaker-labels", "word-midpoint-merge"],
      "outputs": ["SubtitleArtifact"]
    },
    {
      "id": "pipeline-openai-sherpa",
